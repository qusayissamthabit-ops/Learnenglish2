                    <div class="flex flex-wrap items-center space-x-4 space-x-reverse mb-4">
                        <input type="text" id="vocab-search" placeholder="ابحث عن كلمة إنجليزية أو معنى عربي..." class="flex-grow p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 text-lg transition duration-200 text-arabic">
