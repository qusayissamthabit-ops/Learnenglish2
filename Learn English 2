                        <div class="text-center p-8 text-gray-500">
                            <p class="text-xl">ابدأ بالبحث أو اختر مستوى لعرض المفردات.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5. صفحة القصص -->
            <section id="stories-view" class="view hidden">
