        /**
         * معالجة وعرض المفردات الشاملة (بحث وتصفية)
         * @param {Array<Object>} [data=fullVocabularyData] - بيانات المفردات المراد عرضها
         */
        window.renderFullVocabulary = function(data = fullVocabularyData) {
            const container = document.getElementById('vocabulary-results');
            const searchTerm = document.getElementById('vocab-search').value.toLowerCase().trim();
            const levelFilter = document.getElementById('vocab-level-filter').value;

            const filteredData = data.filter(item => {
                const matchesSearch = item.word.toLowerCase().includes(searchTerm) || item.meaning.includes(searchTerm);
                const matchesLevel = levelFilter === '' || item.level === levelFilter;
                return matchesSearch && matchesLevel;
            });

            container.innerHTML = '';

            if (filteredData.length === 0) {
                container.innerHTML = `<div class="text-center p-8 text-gray-500 col-span-full"><p class="text-xl">عذراً، لا توجد مفردات تطابق معايير البحث.</p></div>`;
                return;
            }

            filteredData.slice(0, 100).forEach(item => {
                const card = `
                    <div class="p-3 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-indigo-50 transition duration-150">
                        <span class="text-lg font-bold text-indigo-700">${item.word}</span>
                        <span class="text-xs font-semibold text-gray-500 mr-2 border rounded-full px-2 py-0.5">${item.level}</span>
                        <p class="text-gray-600 mt-1">${item.meaning}</p>
                    </div>
                `;
                container.innerHTML += card;
            });

            if (filteredData.length > 100) {
                container.innerHTML += `<div class="text-center p-3 text-gray-500 col-span-full">تم عرض أول 100 نتيجة من أصل ${filteredData.length} نتيجة مطابقة.</div>`;
            }
        }

        /**
         * إضافة رسالة إلى واجهة الدردشة
         */
        function appendMessage(text, sender) {
            const messageElement = document.createElement('div');
            messageElement.className = 'flex ' + (sender === 'user' ? 'justify-start' : 'justify-end');

            const textContainer = document.createElement('div');
            textContainer.className = 'max-w-xs sm:max-w-md p-4 rounded-xl shadow-md text-arabic ' +
                (sender === 'user' ? 'bg-indigo-600 text-white rounded-tl-none' : 'bg-indigo-100 text-indigo-800 rounded-tr-none');

            textContainer.style.overflowWrap = 'break-word';

            if (sender === 'ai') {
                textContainer.innerHTML = `<span class="typing-cursor"></span>`;
                messageElement.appendChild(textContainer);
                chatBox.appendChild(messageElement);
                chatBox.scrollTop = chatBox.scrollHeight;
                simulateTyping(textContainer, text);
            } else {
                textContainer.textContent = text;
                messageElement.appendChild(textContainer);
                chatBox.appendChild(messageElement);
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        }

        /**
         * محاكاة تأثير الكتابة
         */
        function simulateTyping(element, fullText) {
            let index = 0;
            element.innerHTML = '';
            const interval = setInterval(() => {
                if (index < fullText.length) {
                    element.textContent += fullText.charAt(index);
                    index++;
                    chatBox.scrollTop = chatBox.scrollHeight;
                } else {
                    clearInterval(interval);
                }
            }, 25);
        }

