        /**
         * تبديل عرض الواجهات الرئيسية
         * @param {string} viewId - معرف الواجهة المراد عرضها
         */
        function navigate(viewId) {
            views.forEach(view => {
                view.classList.add('hidden');
            });
            document.getElementById(`${viewId}-view`).classList.remove('hidden');

            // وظائف خاصة لكل واجهة
            if (viewId === 'home') {
                document.getElementById('level-detail-card').classList.add('hidden');
            } else if (viewId === 'stories') {
                renderStories();
            } else if (viewId === 'flashcards') {
                renderMindMaps();
            } else if (viewId === 'vocabulary') {
                renderFullVocabulary(fullVocabularyData.slice(0, 100));
            }
        }

        /**
         * إنشاء وعرض بطاقات مستويات CEFR
         */
        function renderLevelsGrid() {
            const grid = document.getElementById('levels-grid');
            grid.innerHTML = '';
            Object.keys(levelsData).forEach(level => {
                const data = levelsData[level];
                const card = `
                    <div onclick="selectLevel('${level}')"
                         class="level-card ${data.color} text-white p-6 rounded-2xl shadow-xl hover:shadow-2xl transition duration-300 cursor-pointer transform hover:-translate-y-1">
                        <h3 class="text-3xl font-bold mb-2">${level} - ${data.title}</h3>
                        <p class="text-base">${data.description}</p>
                        <div class="mt-4 text-sm font-light opacity-80">انقر لعرض جميع القواعد</div>
                    </div>
                `;
                grid.innerHTML += card;
            });
        }

        /**
         * تحديد وعرض تفاصيل المستوى المحدد
         * @param {string} level - رمز المستوى (A1, B2, etc.)
         */
        window.selectLevel = function(level) {
            currentLevel = level;
            const data = levelsData[level];
            document.getElementById('detail-level-title').textContent = `${level} - ${data.title}`;
            document.getElementById('detail-level-description').textContent = data.description;
            document.getElementById('level-detail-card').classList.remove('hidden');
            document.getElementById('level-detail-card').scrollIntoView({ behavior: 'smooth' });
        }

        /**
         * عرض محتوى محدد (قواعد، مفردات، دروس) للمستوى الحالي
         * @param {string} contentType - نوع المحتوى ('grammar', 'vocabulary', 'multimedia')
         * @param {string} level - رمز المستوى
         */
        window.showContent = function(contentType, level) {
            navigate('content');
            const content = contentData[level] ? contentData[level][contentType] || 'لا يوجد محتوى لهذا القسم حالياً.' : 'لا يوجد بيانات لهذا المستوى.';

            let title;
            if (contentType === 'grammar') title = 'القواعد الشاملة';
            else if (contentType === 'vocabulary') title = 'المفردات الأساسية';
            else if (contentType === 'multimedia') title = 'الدروس المرئية والمسموعة';

            document.getElementById('content-title').textContent = `${title} (${level})`;
            document.getElementById('content-area').innerHTML = content.replace(/\n/g, '<br><br>');
        }

