                <div id="stories-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- سيتم إنشاء بطاقات القصص هنا بواسطة JavaScript -->
                </div>
            </section>

            <!-- 6. صفحة بطاقات المفردات والخرائط الذهنية -->
            <section id="flashcards-view" class="view hidden">
