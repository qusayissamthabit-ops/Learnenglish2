                    </div>
                </div>
            </section>

            <!-- 2. صفحة تفاصيل المحتوى (قواعد، مفردات، دروس) -->
            <section id="content-view" class="view hidden">
                <button onclick="navigate('home')" class="flex items-center text-indigo-600 hover:text-indigo-800 mb-6 font-semibold transition duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5M10.5 6H21m0 0l-5.25 5.25M21 6L15.75 1.5"></path>
                    </svg>
                    العودة للمستويات
                </button>
