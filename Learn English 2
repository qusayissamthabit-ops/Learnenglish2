                <h3 class="text-3xl font-bold text-gray-800 my-8 text-center border-t pt-6">الخرائط الذهنية (Mind Maps)</h3>
                <div id="mindmap-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- سيتم إنشاء بطاقات الخرائط الذهنية هنا بواسطة JavaScript -->
                </div>
            </section>

        </main>

        <!-- تذييل الصفحة -->
        <footer class="bg-gray-800 text-white text-center p-4 mt-8">
            <p class="text-sm text-arabic">منصة إنجليزي - تعلم اللغة الإنجليزية مدعومة بـ Gemini</p>
        </footer>
    </div>

