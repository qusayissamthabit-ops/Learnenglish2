                <div id="levels-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- سيتم إنشاء بطاقات المستويات هنا بواسطة JavaScript -->
                </div>
                <!-- عرض تفاصيل المستوى عند النقر -->
                <div id="level-detail-card" class="mt-12 p-8 bg-white rounded-2xl shadow-xl border-t-4 border-indigo-500 hidden">
                    <h3 id="detail-level-title" class="text-3xl font-bold text-indigo-700 mb-4 border-b pb-2"></h3>
                    <p id="detail-level-description" class="text-lg text-gray-600 mb-6"></p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <button onclick="showContent('grammar', currentLevel)" class="p-4 bg-green-600 text-white font-semibold rounded-xl shadow-md hover:bg-green-700 transition duration-300">القواعد الشاملة</button>
                        <button onclick="showContent('vocabulary', currentLevel)" class="p-4 bg-yellow-600 text-white font-semibold rounded-xl shadow-md hover:bg-yellow-700 transition duration-300">المفردات الأساسية</button>
