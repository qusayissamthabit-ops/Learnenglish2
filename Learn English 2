                    <button onclick="navigate('vocabulary')" class="nav-btn transition duration-300 hover:text-indigo-400 p-2 font-medium">المعاني الشاملة</button>
                    <button onclick="navigate('practice')" class="nav-btn transition duration-300 hover:text-indigo-400 p-2 font-medium">ممارسة (الذكاء الاصطناعي)</button>
                    <button onclick="navigate('stories')" class="nav-btn transition duration-300 hover:text-indigo-400 p-2 font-medium">القصص</button>
